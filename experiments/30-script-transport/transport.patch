+        # Read the script before executing it, so commands see closed stdin
+        # as with non-interactive docker exec. No script-sized argv element.
+        if "\x00" in command:
+            raise ValueError("embedded null byte")
+        loader = (
+            "IFS= read -r -d '' __repo2rlenv_command || :; "
+            "exec 0</dev/null; eval \"$__repo2rlenv_command\""
+        )
+        args = ["docker", "exec", "-i", self.container_id, "bash", "-lc", loader]
+        return _run(args, timeout=timeout, input_text=command)
 
