{
  "branch": "HEAD",
  "clone_depth": 2,
  "exclude_authors": [],
  "limit": 1,
  "llm_temperature": 0.3,
  "max_llm_tokens": 1024,
  "max_pass_to_pass": 50,
  "max_source_files_per_commit": 10,
  "min_fail_to_pass": 1,
  "min_message_words": 5,
  "min_problem_statement_words": 8,
  "require_fail_to_pass": true,
  "require_new_test_funcs": true,
  "since": null,
  "skip_ci_only": true,
  "skip_merge_commits": true,
  "skip_validation": false,
  "synthesize_with_llm": true,
  "until": null,
  "validation_timeout_sec": 600
}
