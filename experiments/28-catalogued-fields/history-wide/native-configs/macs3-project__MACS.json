{
  "repo": {
    "url": "https://github.com/macs3-project/MACS",
    "ref": "88c82d62d239d47b9c8ce9e545eeaaa6b7f695de",
    "access": "public"
  },
  "pipeline": {
    "name": "pr_runtime",
    "options": {
      "limit": 100
    }
  },
  "llm": {
    "provider": "openrouter",
    "model": "anthropic/claude-sonnet-4.6",
    "api_key_env": "OPENROUTER_API_KEY",
    "fallback": null
  },
  "bootstrap": {
    "max_iterations": 20,
    "max_seconds": 1800,
    "max_llm_spend_usd": 5.0,
    "cache_dir": "/work/bootstrap"
  },
  "auth": {
    "use_gh_cli": false,
    "use_hf_cli": false
  },
  "output": {
    "destination": "/work/outputs/macs3-project__MACS",
    "org": "open-athena",
    "dataset_name": "biotasks28-history-wide",
    "visibility": "private"
  }
}
