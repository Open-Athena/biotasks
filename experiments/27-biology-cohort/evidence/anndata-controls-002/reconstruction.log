[build-system]
build-backend = "hatchling.build"
requires = [ "hatch-vcs", "hatchling" ]

[project]
name = "anndata"
description = "Annotated data."
readme = "README.md"
license = "BSD-3-Clause"
maintainers = [
    { name = "Philipp Angerer", email = "philipp.angerer@helmholtz-munich.de" },
    { name = "Ilan Gold", email = "ilan.gold@helmholtz-munich.de" },
]
authors = [
    { name = "Philipp Angerer" },
    { name = "Alex Wolf" },
    { name = "Isaac Virshup" },
    { name = "Sergei Rybakov" },
    { name = "Ilan Gold" },
]
requires-python = ">=3.13"
classifiers = [
    "Environment :: Console",
    "Framework :: Jupyter",
    "Intended Audience :: Developers",
    "Intended Audience :: Science/Research",
    "Natural Language :: English",
    "Operating System :: MacOS :: MacOS X",
    "Operating System :: Microsoft :: Windows",
    "Operating System :: POSIX :: Linux",
    "Programming Language :: Python :: 3 :: Only",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Programming Language :: Python :: 3.15",
    "Topic :: Scientific/Engineering :: Bio-Informatics",
    "Topic :: Scientific/Engineering :: Visualization",
    "Typing :: Typed",
]
dynamic = [ "version" ]
dependencies = [
    "array-api-compat>=1.7.1",
    "h5py>=3.12",
    "legacy-api-wrap",
    "natsort",
    "numpy>=2.2",
    "packaging>=24.2",
    "pandas>=2.3",
    "scipy>=1.15,!=1.17",
    "scverse-misc[settings]>=0.1.3",
    # `typing_extensions.sentinel`, see `anndata.acc`
    "typing-extensions>=4.16; python_version<'3.15'",
    "zarr>=3.1",
]
optional-dependencies.cu11 = [ "cupy-cuda11x" ]
optional-dependencies.cu12 = [ "cupy-cuda12x" ]
optional-dependencies.cu13 = [ "cupy-cuda13x" ]
# https://github.com/dask/dask/issues/11290
# https://github.com/dask/dask/issues/11752
optional-dependencies.dask = [
    "dask!=2024.8.*,!=2024.9.*,!=2025.2.*,!=2025.3.*,!=2025.4.*,!=2025.5.*,!=2025.6.*,!=2025.7.*,!=2025.8.*",
    "dask[array]>=2024.5.1",
]
optional-dependencies.gpu = [ "cupy" ]
# requests and aiohttp needed for zarr remote data
optional-dependencies.lazy = [ "aiohttp", "anndata[dask]", "requests", "xarray>=2025.6.1" ]
urls.Documentation = "https://anndata.readthedocs.io/"
urls.Home-page = "https://github.com/scverse/anndata"
urls.Source = "https://github.com/scverse/anndata"

[dependency-groups]
dev = [
    { include-group = "dev-doc" },
    { include-group = "typing" },
]
test = [
    "anndata[lazy]",
    "fast-array-utils>=1.2.3",
    { include-group = "test-min" },
]
dev-doc = [
    "towncrier>=24.8", # release notes tool
    "types-array-api", # for dev and linking in the docs
]
doc = [
    "anndata[dask]",
    "awkward>=2.6.3",
    "ipython",                          # For syntax highlighting in notebooks
    "mudata",
    "myst-nb>=1.4",
    "pandas>=3",
    "scverse-doc[full]>=0.2.3",
    "scverse-misc[sphinx]",
    "sphinx>=9.1",
    "sphinx-autodoc-typehints>=3.13.6",
    "sphinx-issues>=5.0.1",
    # for unreleased changes
    { include-group = "dev-doc" },
]
test-array-api = [
    { include-group = "test-jax" },
