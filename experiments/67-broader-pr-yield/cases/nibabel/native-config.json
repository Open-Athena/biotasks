{
  "repo": {
    "url": "https://github.com/nipy/nibabel",
    "ref": "fdacbf05c15f06125a481c3345a5de55a32f9ba2",
    "access": "public"
  },
  "pipeline": {
    "name": "pr_runtime",
    "options": {
      "limit": 100,
      "since": "1970-01-01",
      "until": "2026-10-17",
      "require_new_test_funcs": false
    }
  },
  "llm": {
    "provider": "openrouter",
    "model": "anthropic/claude-sonnet-4.6",
    "api_key_env": "OPENROUTER_API_KEY",
    "fallback": null
  },
  "bootstrap": {
    "max_iterations": 20,
    "max_seconds": 1800,
    "max_llm_spend_usd": 5.0,
    "cache_dir": "./workspace/bootstrap"
  },
  "auth": {
    "use_gh_cli": false,
    "use_hf_cli": false
  },
  "output": {
    "destination": "/work/outputs/raw",
    "org": "open-athena",
    "dataset_name": "biotasks67-nibabel",
    "visibility": "private"
  }
}
