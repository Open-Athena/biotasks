ha256": "96785e7a75cad71595e53fcb8034879822a15b78d0f95d3ee5956d4e1e788e78", "subject_bundle_hash": "sha256:be244320301182840a1e8a9b453b363a9fd227ac6e1c7ece39aea17ce00761be", "harbor_task_checksum": "784ecf6407b847d5bab7766703c980161de621013e8ae023690934ba99d748c8"}]}}, "evidence": {"native_trials": [{"role": "baseline", "reward": 0.0, "exception_type": null, "bundle_hash": "sha256:be244320301182840a1e8a9b453b363a9fd227ac6e1c7ece39aea17ce00761be", "result_sha256": "8c539eb4c0ad531bbb568727cb9fc55b50e37c095ce03857f4ef30134cf2c7be", "agent_execution": {"started_at": "2026-10-13T18:08:58.522046Z", "finished_at": "2026-10-13T18:08:58.522117Z"}, "probe": null}, {"role": "oracle", "reward": 1.0, "exception_type": null, "bundle_hash": "sha256:be244320301182840a1e8a9b453b363a9fd227ac6e1c7ece39aea17ce00761be", "result_sha256": "c842c3b836bbe77fc6c8387c7f19635c0478ea3f2f2f4b90f4251aa163d7f64c", "agent_execution": {"started_at": "2026-10-13T18:09:18.747294Z", "finished_at": "2026-10-13T18:09:26.518115Z"}, "probe": null}, {"role": "probe", "reward": 0.0, "exception_type": null, "bundle_hash": "sha256:26670d88b7385af4ba0e157dc3576621e4fbda33c1e46fed328bed7a681ab255", "result_sha256": "15b097e5ab6e3d8b77a15451d64b18ad32756d12529511e26131c5e887ec403b", "agent_execution": {"started_at": "2026-10-13T18:10:09.505095Z", "finished_at": "2026-10-13T18:10:23.754334Z"}, "probe": {"evidence": [{"path": "instruction.md", "quote": "3. Filter **genes** detected in fewer than **3** cells."}, {"path": "tests/test_outputs.py", "quote": "assert list(stu.var_names) == list(ref.var_names), \"gene set/order differs\""}], "focus": "general", "kind": "wrong_solution", "name": "skip-gene-filter", "rationale": "A pipeline that omits the min_cells=3 gene filter is a plausible scientific error that changes the graded shape (13714 vs more genes) and the counts layer, so the verifier must reject it on this dataset.", "script": "#!/bin/bash\nset -euo pipefail\nmkdir -p /workspace/output\npython - <<'PY'\nimport scanpy as sc\nDATA = \"/opt/data/filtered_gene_bc_matrices/hg19\"\nadata = sc.read_10x_mtx(DATA, var_names=\"gene_symbols\", cache=False)\nadata.var_names_make_unique()\nsc.pp.filter_cells(adata, min_genes=200)\n# WRONG: gene filter omitted (should be min_cells=3)\nadata.var[\"mt\"] = adata.var_names.str.startswith(\"MT-\")\nsc.pp.calculate_qc_metrics(adata, qc_vars=[\"mt\"], percent_top=None, log1p=False, inplace=True)\nadata = adata[(adata.obs.n_genes_by_counts > 200) & (adata.obs.n_genes_by_counts < 2500) & (adata.obs.pct_counts_mt < 5)].copy()\nadata.layers[\"counts\"] = adata.X.copy()\nsc.pp.normalize_total(adata, target_sum=1e4)\nsc.pp.log1p(adata)\nadata.write_h5ad(\"/workspace/output/pbmc3k_processed.h5ad\")\nprint(\"done\")\nPY\nexit 0"}}, {"role": "probe", "reward": 1.0, "exception_type": null, "bundle_hash": "sha256:f2ec80555acb1dfaa1dd88287481aacea1810b564dbb95e9d8171d5957763c13", "result_sha256": "99af2c5c00ff8e031d365807c6ae37d5335b28e187433ea5bf20dbba0b7ce6d9", "agent_execution": {"started_at": "2026-10-13T18:10:45.786282Z", "finished_at": "2026-10-13T18:10:55.839302Z"}, "probe": {"evidence": [{"path": "instruction.md", "quote": "Any tool implementing the stated methodology is acceptable; grading is based on the contents of the output file only."}, {"path": "instruction.md", "quote": "X[i, j] = log(1 + counts[i, j] * 10000 / total_counts[i])"}], "focus": "general", "kind": "valid_alternative", "name": "no-scanpy-implementation", "rationale": "The instruction permits any tool implementing the stated methodology. A pure scipy/pandas/anndata implementation that reads the mtx/genes.tsv/barcodes.tsv directly and performs the same filtering, QC and normalization must pass, exercising that grading does not depend on scanpy-specific code or internal representations.", "script": "#!/bin/bash\nset -euo pipefail\nmkdir -p /workspace/output\npython - <<'PY'\nimport numpy as np, pandas as pd, anndata as ad\nfrom scipy import io as sio, sparse\nD = \"/opt/data/filtered_gene_bc_matrices/hg19\"\nM = sio.mmread(D + \"/matrix.mtx\").T.tocsr()  # cells x genes\ngenes = pd.read_csv(D + \"/genes.tsv\", sep=\"\\t\", header=None)\nbarcodes = pd.read_csv(D + \"/barcodes.tsv\", sep=\"\\t\", header=None)\n# make unique gene symbols (same convention as scanpy: dup -> sym-1, sym-2, ...)\nsym = genes[1].astype(str).tolist()\nseen = {}\nuniq = []\nfor s in sym:\n    if s in seen:\n        seen[s] += 1\n        uniq.append(f\"{s}-{seen[s]}\")\n    else:\n        seen[s] = 0\n        uniq.append(s)\nvar = pd.DataFrame(index=pd.Index(uniq, name=\"genes\"))\nvar[\"gene_ids\"] = genes[0].astype(str).values\nobs = pd.DataFrame(index=pd.Index(barcodes[0].astype(str).tolist(), name=\"barcodes\"))\nadata = ad.AnnData(X=M.astype(np.float32), obs=obs, var=var)\n# filter cells < 200 genes\ncell_ng = np.asarray((M > 0).sum(axis=1)).ravel()\nadata = adata[cell_ng >= 200].copy()\n# filter genes < 3 cells\ngene_nc = np.asarray((M > 0).sum(axis=0)).ravel()\nadata = adata[:, gene_nc >= 3].copy()\nC = sparse.csr_matrix(adata.X)\nmt = np.asarray(adata.var_names.str.startswith(\"MT-\"))\ntotal = np.asarray(C.sum(axis=1)).ravel()\nadata.obs[\"n_genes_by_counts\"] = np.asarray((C > 0).sum(axis=1)).ravel()\nadata.obs[\"total_counts\"] = total\nadata.obs[\"pct_counts_mt\"] = 100.0 * np.asarray(C[:, mt].sum(axis=1)).ravel() / total\nkeep = (adata.obs.n_genes_by_counts > 200) & (adata.obs.n_genes_by_counts < 2500) & (adata.obs.pct_counts_mt < 5)\nadata = adata[np.asarray(keep)].copy()\nC = sparse.csr_matrix(adata.X)\nadata.var[\"mt\"] = adata.var_names.str.startswith(\"MT-\")\nadata.layers[\"counts\"] = C.astype(np.float32).copy()\ntotal = np.asarray(C.sum(axis=1)).ravel()\nX = C.astype(np.float64)\nX.data = np.log1p(X.data * (1e4 / np.repeat(total, np.diff(X.indptr))))\nadata.X = X.astype(np.float32)\nadata.write_h5ad(\"/workspace/output/pbmc3k_processed.h5ad\")\nprint(\"done\", adata.shape)\nPY\nexit 0"}}, {"role": "rollout", "reward": 1.0, "exception_type": null