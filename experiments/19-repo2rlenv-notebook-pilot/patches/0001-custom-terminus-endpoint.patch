+"""Explicit custom-endpoint routing for the external Terminus harness."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from urllib.parse import urlsplit
+
+
+def trial_model_route(model, *, agent: str) -> tuple[list[str], str]:
+    """Return public harness arguments and a credential-free route identity.
+
+    The caller forwards the resolved key through the harness process environment.
+    This function never reads credentials or changes the task's network policy.
+    """
+    if model.provider not in {"openai", "anthropic"} or model.fallback:
+        raise ValueError("Blind trials require explicit OpenAI/Anthropic routes without fallback")
+    arguments = []
+    if model.endpoint:
+        if agent != "terminus-2" or model.provider != "openai":
+            raise ValueError("Custom endpoints require the OpenAI-compatible Terminus route")
+        if not model.api_key_env:
+            raise ValueError("Custom endpoints require an explicit API-key environment variable")
+        endpoint = urlsplit(model.endpoint)
+        if (
+            endpoint.scheme not in {"http", "https"}
+            or not endpoint.hostname
+            or endpoint.username
+            or endpoint.password
+            or endpoint.query
+            or endpoint.fragment
+        ):
+            raise ValueError("Endpoint must be an HTTP(S) base URL without embedded credentials")
+        arguments += ["--ak", "api_base=" + model.endpoint]
+    if model.model_info:
+        if agent != "terminus-2":
+            raise ValueError("Custom model metadata requires Terminus")
+        arguments += ["--ak", "model_info=" + json.dumps(model.model_info, sort_keys=True)]
+    identity = hashlib.sha256(json.dumps({
+        "provider": model.provider,
+        "model": model.model,
+        "endpoint": model.endpoint,
+        "api_key_env": model.api_key_env,
+        "model_info": model.model_info,
+    }, sort_keys=True).encode()).hexdigest()
+    return arguments, identity
