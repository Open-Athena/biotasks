@@ -0,0 +1,49 @@
+from types import SimpleNamespace
+
+import pytest
+
+from repo2rlenv.execution.model_route import trial_model_route
+
+
+def spec(**changes):
+    fields = dict(provider="openai", model="test-model", fallback=None,
+                  endpoint="https://inference.example/v1", api_key_env="TEST_MODEL_KEY",
+                  model_info={"max_input_tokens": 120000, "max_output_tokens": 8192})
+    return SimpleNamespace(**(fields | changes))
+
+
+def test_custom_route_has_explicit_metadata_without_credential_values(monkeypatch):
+    monkeypatch.setenv("TEST_MODEL_KEY", "SECRET_SHOULD_NOT_APPEAR")
+    arguments, identity = trial_model_route(spec(), agent="terminus-2")
+    assert "api_base=https://inference.example/v1" in arguments
+    assert any(item.startswith("model_info=") for item in arguments)
+    assert "SECRET_SHOULD_NOT_APPEAR" not in str((arguments, identity))
+    assert len(identity) == 64
+
+
+def test_default_route_stays_unchanged():
+    args, _ = trial_model_route(spec(endpoint=None, model_info=None), agent="terminus-2")
+    assert args == []
+
+
+@pytest.mark.parametrize("changes", [
+    {"fallback": "other-model"}, {"api_key_env": None}, {"provider": "anthropic"},
+    {"endpoint": "https://user:secret@example.com/v1"},
+    {"endpoint": "https://example.com/v1?api_key=secret"},
+    {"endpoint": "file:///tmp/model"},
+])
+def test_rejects_ambiguous_or_credential_bearing_routes(changes):
+    with pytest.raises(ValueError):
+        trial_model_route(spec(**changes), agent="terminus-2")
+
+
+def test_does_not_expand_responses_agent_support():
+    with pytest.raises(ValueError):
+        trial_model_route(spec(), agent="responses")
+
+
+def test_resume_identity_changes_with_endpoint_or_metadata():
+    _, original = trial_model_route(spec(), agent="terminus-2")
+    _, changed = trial_model_route(spec(endpoint="https://other.example/v1"), agent="terminus-2")
+    _, metadata = trial_model_route(spec(model_info={"max_input_tokens": 64000}), agent="terminus-2")
+    assert len({original, changed, metadata}) == 3
