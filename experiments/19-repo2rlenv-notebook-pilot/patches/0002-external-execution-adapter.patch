+++ b/src/repo2rlenv/execution/daytona_cleanup.py
@@ -0,0 +1,28 @@
+"""Delete only sandboxes explicitly labeled by this remote job supervisor."""
+from __future__ import annotations
+
+from daytona import Daytona, ListSandboxesQuery
+from daytona.common.errors import DaytonaNotFoundError
+
+
+def cleanup(job_id: str, client=None) -> dict:
+    client = client or Daytona()
+    labels = {"repo2rlenv.job": job_id}
+    owned = list(client.list(ListSandboxesQuery(labels=labels), request_timeout=15))
+    records = []
+    for sandbox in owned:
+        if any(sandbox.labels.get(key) != value for key, value in labels.items()):
+            raise ValueError("Provider returned a sandbox with different ownership")
+        row = {"id": sandbox.id, "cpu": sandbox.cpu,
+               "memory": sandbox.memory, "disk": sandbox.disk}
+        client.delete(sandbox, timeout=60, wait=True)
+        try:
+            remaining = client.get(sandbox.id, request_timeout=15)
+        except DaytonaNotFoundError:
+            row["deleted"] = True
+        else:
+            row["deleted"] = getattr(remaining.state, "value", remaining.state) == "destroyed"
+        records.append(row)
+    remaining = list(client.list(ListSandboxesQuery(labels=labels), request_timeout=15))
+    return {"passed": not remaining and all(row["deleted"] for row in records),
+            "sandboxes": records, "remaining": [s.id for s in remaining]}
