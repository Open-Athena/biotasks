  "required": [
    "disposition",
    "explanation",
    "environment_rationale",
    "pyproject_toml",
    "system_packages",
    "stage_inputs_sh",
    "changes",
    "artifacts",
    "branches",
    "excluded_outputs",
    "unresolved_assumptions"
