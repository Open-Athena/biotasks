  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "branches": {
      "description": "JSON array of scientific branch records, not a string.",
      "items": {
        "$ref": "#/$defs/Branch"
      },
      "title": "Branches",
      "type": "array"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "disposition": {
      "description": "Required admission decision: prepare a faithful reference, or reject with a reason.",
      "enum": [
        "prepare",
        "reject"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "environment_rationale": {
      "title": "Environment Rationale",
      "type": "string"
    },
    "excluded_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Outputs",
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "pyproject_toml": {
      "title": "Pyproject Toml",
      "type": "string"
    },
    "stage_inputs_sh": {
      "title": "Stage Inputs Sh",
      "type": "string"
    },
    "system_packages": {
      "items": {
        "type": "string"
      },
      "title": "System Packages",
      "type": "array"
    },
    "unresolved_assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Assumptions",
      "type": "array"
    }
