{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source_evidence": {
          "minLength": 1,
          "title": "Source Evidence",
          "type": "string"
        }
      },
      "required": [
        "path",
        "description",
        "source_evidence"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Branch": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scientific_result": {
          "minLength": 1,
          "title": "Scientific Result",
          "type": "string"
        },
        "source_evidence": {
          "minLength": 1,
          "title": "Source Evidence",
          "type": "string"
        }
      },
      "required": [
        "name",
        "scientific_result",
        "source_evidence",
        "artifacts"
      ],
      "title": "Branch",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "input_staging",
            "export",
            "capture"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "before",
        "after",
        "justification"
      ],
      "title": "Change",
      "type": "object"
    }
