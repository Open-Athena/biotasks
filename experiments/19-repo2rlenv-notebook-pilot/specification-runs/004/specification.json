fd0\u884c\uff1b\u8bc1\u636e\u8fb9\u754c\u8bb0\u5f55\u6ca1\u6709\u53ef\u91cd\u590d\u6027\u6d4b\u91cf\u3002\u6bcf\u4e2a\u7aef\u70b9\u90fd\u4f9d\u8d56\u4e8e notebook \u672c\u8eab\u5728\u5176\u65b9\u6cd5\u4e2d\u786c\u7f16\u7801\u7684\u7c07\u7f16\u53f7\uff08`\u300e0\u300f\u2192Lymphocytes \u2026 \u300e4\u300f\u2192Erythroid` \u9488\u5bf9 `leiden_res_0.02`\uff09\uff0c\u4e14 DE \u8868\u672c\u8eab\u5c31\u662f\u4ee5 `leiden_res_0.50` \u6807\u7b7e\u4e3a\u952e\u7684\u3002\u5728\u6240\u8bb0\u5f55\u7684\u6c99\u7bb1\uff084 CPUs, 8 GiB\uff09\u4e2d\u81f3\u5c11\u9700\u8981\u4fdd\u7559\u7684\u6d41\u6c34\u7ebf\u8fdb\u884c\u4e24\u6b21\u91cd\u65b0\u8fd0\u884c\uff0c\u6d4b\u91cf\uff1a\u9010\u5217\u6807\u7b7e\u4e00\u81f4\u6027\u3001`umap_1`/`umap_2` \u7684 max |\u0394|\u3001scores/`pvals_adj`/`logfoldchanges` \u7684 max |\u0394|\u3001\u89c2\u6d4b\u5230\u7684 p \u503c\u4e0b\u6ea2/\u5e73\u5c40\u884c\u4e3a\uff0c\u4ee5\u53ca\u884c\u987a\u5e8f\u7a33\u5b9a\u6027\uff08\u5b58\u50a8\u7684 `dtype-names` \u7ec4\u987a\u5e8f\u548c\u7ec4\u5185\u5e73\u5c40\u987a\u5e8f\uff09\u3002\u8fd9\u51b3\u5b9a\u4e86\u662f\u5426\u53ef\u4ee5\u5f3a\u5236\u6267\u884c\u7cbe\u786e\u7684\u53c2\u8003\u7f16\u53f7\uff0c\u5e76\u63d0\u4f9b\u4efb\u4f55\u6570\u503c\u5bb9\u5dee\u3002 nn2. **Leiden \u626b\u63cf\u8bed\u4e49\uff08\u6e90\u7801\u68c0\u67e5\uff09\u3002** \u9ed8\u8ba4\u5206\u8fa8\u7387\u7684\u8c03\u7528\u4f20\u9012\u4e86 `n_iterations=2`\uff1b\u4e09\u4e2a\u626b\u63cf\u8c03\u7528\u5219\u7701\u7565\u4e86\u5b83\u3002\u65e0\u8bba\u662f\u6709\u9ed8\u8ba4\u503c\u8fd8\u662f\u5728 `flavor=\u300eigraph\u300f` \u4e0b\u7684\u542b\u4e49\u5747\u672a\u8bb0\u5f55\u5728\u63d0\u4f9b\u7684\u6587\u4ef6\u4e2d\uff0c\u4e14\u7248\u672c\u9501\u5b9a\uff08scanpy 1.12.4, igraph 1.0.0\uff09\u5e76\u4e0d\u662f\u672a\u8bb0\u5f55\u9ed8\u8ba4\u503c\u7684\u8bc1\u636e\u3002\u68c0\u67e5 scanpy 1.12.4 `_leiden.py` \u548c igraph 1.0.0 `community_leiden` \u4ee5\u83b7\u53d6\uff1a\u626b\u63cf\u7684\u6709\u6548 `n_iterations`\u3001\u76ee\u6807\u51fd\u6570\u4ee5\u53ca `resolution` \u5982\u4f55\u8fdb\u5165\u5176\u4e2d\u3001\u9ed8\u8ba4\u7684 `random_state` \u5982\u4f55\u521d\u59cb\u5316 igraph \u7684 RNG\u3001`directed`/`use_weights` \u7684\u89e3\u6790\uff0c\u4ee5\u53ca\u793e\u533a\u7f16\u53f7\u7ea6\u5b9a\u3002\u7b80\u62a5\u7edd\u4e0d\u80fd\u5c06 `n_iterations=2` \u7684\u8986\u76d6\u4f20\u64ad\u5230\u626b\u63cf\u4e2d\uff0c\u4e5f\u4e0d\u80fd\u731c\u6d4b\u5176\u9ed8\u8ba4\u503c\u3002nn3. **\u5176\u4ed6\u5173\u952e\u7684\u9690\u5f0f\u9ed8\u8ba4\u503c\uff08\u6e90\u7801\u68c0\u67e5\uff09\u3002** \u516c\u5f00\u7b80\u62a5\u5fc5\u987b\u8bf4\u660e `pp.normalize_total` \u9ed8\u8ba4\u7684 `target_sum` \u8bed\u4e49\uff1b`pp.highly_variable_genes`\uff08\u9ed8\u8ba4 `flavor` \u4ee5\u53ca\u5728 `n_top_genes=2000, batch_key=\u300esample\u300f` \u4e0b\u7684\u6279\u6b21\u611f\u77e5\u9009\u62e9\uff09\uff1b`tl.pca`\uff08`n_comps`\uff0c\u662f\u5426\u4f7f\u7528\u4e86 2000 \u4e2a HVG\uff0c\u5728\u8be5\u5f62\u72b6\u4e0b\u9009\u62e9\u7684\u6c42\u89e3\u5668\uff09\uff1b`pp.neighbors`\uff08`n_neighbors`, `use_rep`, `method`/`metric`, `random_state`\uff0c\u4ee5\u53ca\u5bf9\u4e8e 17,041\u00d750 \u662f\u5426\u8fd0\u884c\u4e86\u8fd1\u4f3c\u7684 `pynndescent` \u8def\u5f84\uff09\uff1b`tl.umap`\uff08`init`, `min_dist`, `spread`, `epochs`, `random_state`\uff09\u3002\u8fd9\u4e9b\u56e0\u7d20\u4e3a\u6240\u6709\u5bfc\u51fa\u7684\u6570\u5b57\u63d0\u4f9b\u8f93\u5165\uff0c\u4e14\u6211\u4e0d\u4f1a\u51ed\u8bb0\u5fc6\u5199\u4e0b\u3002nn4. **DE \u516c\u5f0f\u5c42\u9762\u7684\u8bed\u4e49\u3002** \u7aef\u70b9 2 \u7684\u516c\u5f00\u5217\u8bed\u4e49\u9700\u8981 scanpy-1.12.4 Wilcoxon \u5206\u6570\u5b9a\u4e49\uff08\u7f29\u653e\u3001\u7b26\u53f7\uff09\u3001\u5e73\u5c40\u5904\u7406\u3001p \u503c\u8ba1\u7b97\u3001BH \u8c03\u6574\u3001\u7cbe\u786e\u7684 `logfoldchanges` \u516c\u5f0f\uff0c\u4ee5\u53ca\u5b58\u50a8\u7684\u7ec4\u5185\u6392\u5e8f\u89c4\u5219\uff08\u5206\u6570\u6309\u964d\u5e8f? \u5e73\u5c40\u987a\u5e8f?\uff09\u3002\u4e0d\u80fd\u4ece\u5176 85.9/\u221267.2 \u6216 0.0\u20131.0 \u7684\u8303\u56f4\u4e2d\u63a8\u65ad\u51fa\u8fd9\u4e9b\u5185\u5bb9\u3002nn5. **\u6e90\u81ea\u8f93\u5165\u7684\u6052\u7b49\u6027\u3002** `ad.concat` \u9ed8\u8ba4\u503c\uff08`join`, \u5143\u7d20\u987a\u5e8f\uff09\u52a0\u4e0a `obs_names_make_unique` \u540e\u7f00\u5316\uff08anndata 0.13.4\uff09\u5b9a\u4e49\u4e86\u5bfc\u51fa\u7684 `cell_id` \u6570\u503c\uff0c\u5e76\u4e14 `read_10x_h5` + concat + `min_cells=3` \u5b9a\u4e49\u4e86 DE \u884c\u7684 23,427 \u4e2a\u57fa\u56e0\u7684\u5168\u96c6\u3002\u8fd9\u4e9b\u5b9a\u4e49\u4e86\u884c\u6052\u7b49\u6027\uff0c\u5fc5\u987b\u52a0\u4ee5\u8bb0\u5f55\uff0c\u800c\u4e0d\u662f\u4ece\u89c2\u5bdf\u5230\u7684\u8868\u683c\u4e2d\u53cd\u5411\u63a8\u65ad\u3002nn6. **\u7aef\u70b9\u4e0d\u53d8\u6027\u786e\u8ba4\u3002** \u5728 scanpy 1.12.4 \u6e90\u7801\u4e2d\u786e\u8ba4 `pp.scrublet` \u548c `pp.calculate_qc_metrics` \u4ec5\u4e3a\u6ce8\u91ca\u6027\u8d28\uff08\u4e0d\u7a81\u53d8 `adata.X` / `var`\uff09\u3002\u5982\u679c\u662f\u8fd9\u6837\uff0c\u63d0\u4ea4\u7684\u4ea7\u7269\u65e0\u6cd5\u533a\u5206\u8fd9\u4e9b\u6b65\u9aa4\u662f\u5426\u8fd0\u884c\uff1b\u7b80\u62a5\u5fc5\u987b\u660e\u786e\u8bf4\u660e\u8fd9\u79cd\u7f29\u5c0f\u8303\u56f4\uff08\u5b83\u4eec\u4fdd\u7559\u5728\u65b9\u6cd5\u8bf4\u660e\u4e2d\uff0c\u4f46\u8f93\u51fa\u7ed3\u679c\u65e0\u6cd5\u9a8c\u8bc1\uff09\u3002\u8be5\u786e\u8ba4\u5bf9\u4e8e\u5ba1\u67e5\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u8f83\u4f4e\u7684\u4f53\u7cfb\u3002nn## \u975e\u963b\u788d\u9879 n n-\u6c42\u89e3\u8005\u5141\u8bb8\u65f6\u95f4\u5df2\u660e\u786e\u8bbe\u5b9a\u4e3a 600 \u79d2\u5e76\u6807\u8bb0\u4e3a\u4e34\u65f6\uff1b\u5728\u6c42\u89e3\u8005\u6267\u884c\u524d\u9700\u91cd\u65b0\u786e\u8ba4\uff08\u6309\u653f\u7b56\u4fdd\u6301\u4e34\u65f6\u72b6\u6001\uff09\u3002\u9a8c\u8bc1\u8005\u7684 120 \u79d2\u9884\u7b97\u5fc5\u987b\u5bf9\u7167\u89e3\u6790\u4e00\u4e2a\u5927\u7ea6 28 MB \u7684 CSV \u8fdb\u884c\u68c0\u67e5\u3002n- \u4e00\u4e2a\u8de8\u8d8a\u6240\u6709\u4e09\u4e2a\u4ea7\u7269\u7684\u4efb\u52a1\u