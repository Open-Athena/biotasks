+# --- Reference exports (appended, read-only): endpoint results -----------------
+import numpy as _np
+import pandas as _pd
+from pathlib import Path as _Path
+
+_out_dir = _Path("/work/outputs")
+_out_dir.mkdir(parents=True, exist_ok=True)
+
+# 1) Complete end state of the analysis (all branches):
+#    obs, var, obsm (X_pca, X_umap), varm (PCs), obsp (neighbor graph),
+#    layers (counts), X (log1PF) and uns (hvg, pca, umap, neighbors, leiden
+#    colors, rank_genes_groups).
+adata.write_h5ad(_out_dir / "final_adata.h5ad")
+
+# 2) Per-cell results with cell identifiers, UMAP coordinates and the first
+#    four principal components (underlying values of the violin/scatter/QC/PCA/
+#    UMAP plots).
+_cell_df = adata.obs.copy()
+_cell_df[["X_pc_1", "X_pc_2", "X_pc_3", "X_pc_4"]] = adata.obsm["X_pca"][:, :4]
+_cell_df[["X_umap_1", "X_umap_2"]] = adata.obsm["X_umap"]
+_cell_df.to_csv(_out_dir / "cell_metadata.csv", index_label="cell_id")
+
+# 3) Per-gene QC, filtering and highly-variable-gene results with gene names.
+adata.var.to_csv(_out_dir / "gene_metadata.csv", index_label="gene_id")
+
+# 4) Variance contribution per principal component (plotted values of
+#    sc.pl.pca_variance_ratio(adata, n_pcs=50, log=True)).
+_variance_ratio = _np.asarray(adata.uns["pca"]["variance_ratio"], dtype=float)
+_pca_df = _pd.DataFrame(
+    {
+        "pc": _np.arange(1, _variance_ratio.shape[0] + 1),
+        "variance_ratio": _variance_ratio,
+    }
+)
+_pca_df.to_csv(_out_dir / "pca_variance_ratio.csv", index=False)
+
+# 5) Wilcoxon rank_genes_groups results for all clusters of leiden_res_0.50,
+#    via the native accessor also used by the source for cluster "7".
+_rg_group_names = list(adata.uns["rank_genes_groups"]["names"].dtype.names)
+_rg_frames = []
+for _rg_group in _rg_group_names:
+    _rg_frame = sc.get.rank_genes_groups_df(adata, group=_rg_group)
+    _rg_frame.insert(0, "group", _rg_group)
+    _rg_frames.append(_rg_frame)
+_rg_table = _pd.concat(_rg_frames, ignore_index=True)
+_rg_table.to_csv(
+    _out_dir / "rank_genes_groups_leiden_res_0.50.csv", index=False
+)
+
 # You may have noticed that the p-values found here are extremely low. This is due to the statistical test being performed considering each cell as an independent sample. For a more conservative approach you may want to consider "pseudo-bulking" your data by sample (*e.g.* `sc.get.aggregate(adata, by=["sample", "cell_type"], func="sum", layer="counts")`) and using a more powerful differential expression tool, like {doc}`pydeseq2 <pydeseq2:index>`.
