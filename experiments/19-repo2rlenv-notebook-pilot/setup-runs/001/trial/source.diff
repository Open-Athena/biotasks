+#    /work/cache/scverse_tutorials (the staged original dataset files)
+#    instead of the default user cache under $HOME.
+import os
+
+os.environ["XDG_CACHE_HOME"] = "/work/cache"
+
+import matplotlib
+
+matplotlib.use("Agg")
+
