{
  "repo": {
    "url": "https://github.com/opencobra/cobrapy",
    "ref": "a9c5ced29670bed5035fb19e87e7b0b588adb62d",
    "access": "public"
  },
  "pipeline": {
    "name": "pr_runtime",
    "options": {
      "limit": 50,
      "since": "2026-10-12",
      "until": "2026-10-12"
    }
  },
  "llm": {
    "provider": "openrouter",
    "model": "anthropic/claude-sonnet-4.6",
    "api_key_env": "OPENROUTER_API_KEY",
    "fallback": null
  },
  "bootstrap": {
    "max_iterations": 20,
    "max_seconds": 1800,
    "max_llm_spend_usd": 5.0,
    "cache_dir": "./workspace/bootstrap"
  },
  "auth": {
    "use_gh_cli": false,
    "use_hf_cli": false
  },
  "output": {
    "destination": "/work/outputs/raw",
    "org": "open-athena",
    "dataset_name": "biotasks45-reference",
    "visibility": "private"
  }
}
