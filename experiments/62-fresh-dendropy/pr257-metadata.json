  "title": "Validate zero-based posterior quantile ranks",
  "user": {
    "login": "antonsoo",
    "id": 42787049,
    "node_id": "MDQ6VXNlcjQyNzg3MDQ5",
    "avatar_url": "https://avatars.githubusercontent.com/u/42787049?v=4",
