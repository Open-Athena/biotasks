+    >>> dataset = load_ksol()
+    >>> dataset  # doctest: +SKIP
+    (['O=C(NCC(F)F)[C@H](NC1=CC2=C(C=C1Br)CNC2)C1=CC(Cl)=CC(C2CC2)=C1', ..., 'COC[C@H]1CN(C2=CN=CC3=CC=CC=C23)C(=O)[C@@]12CN(CC1=CC=NN1)C(=O)C2'], \
+    array([333., ..., 397.]))
+    """
+    df = fetch_dataset(
+        data_dir,
+        dataset_name="ASAP_OpenADMET_KSOL",
